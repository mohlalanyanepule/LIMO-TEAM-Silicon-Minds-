# LIMO example 1 - arithmetic and logic
# Expected: r5=12 r6=2 r7=16 r8=4 r9=7 r10=8 r11=20
eketsa ho r3, r0, 7      # r3 = 7
eketsa ho r4, r0, 5      # r4 = 5
eketsa r5, r3, r4        # r5 = 7 + 5 = 12
fokotsa r6, r3, r4       # r6 = 7 - 5 = 2
eketsa ho r7, r5, 4      # r7 = 12 + 4 = 16
le r8, r5, r3            # r8 = 12 AND 7 = 4
kapa r9, r3, r4          # r9 = 7 OR 5 = 7
kopanyetsa r10, r5, 8    # r10 = 12 AND 8 = 8
suthisa r11, r4, 2       # r11 = 5 << 2 = 20
fin: tekano r0, r0, fin  # halt: branch to itself
