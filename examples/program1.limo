# =====================================================
# program1.limo — Arithmetic and Logic Demo
# Silicon Minds · CS3520 · LIMO
# =====================================================
# Computes: ((a + b) << 2) AND mask  |  (a OR b)
# where a = 7, b = 5
# Expected: register x10 = ((7+5)<<2) AND 255 = 48
#           register x11 = 7 OR 5 = 7
# =====================================================

        # Load constants into registers
        eketsa-haufi x5, lefela, 7         # x5 = 7         (a)
        eketsa-haufi x6, lefela, 5         # x6 = 5         (b)

        # x7 = a + b = 12
        eketsa       x7, x5, x6

        # x8 = x7 << 2 = 48  (shift left by 2)
        eketsa-haufi x9, lefela, 2         # x9 = shift amount = 2
        eketsa-habeli x8, x7, x9

        # x10 = x8 AND 255 = 48
        eketsa-haufi x12, lefela, 255
        kopanya      x10, x8, x12

        # x11 = a OR b = 7
        hokela       x11, x5, x6

        # Store results to memory at address 0 and 4
        boloka       x10, 0(mokgethi)
        boloka       x11, 4(mokgethi)

        # Endless loop at end of program
fin:    hlahloba     lefela, lefela, fin       # branch to self (beq x0, x0, fin)
