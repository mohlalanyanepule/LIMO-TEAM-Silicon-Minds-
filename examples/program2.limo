# LIMO example 2 - array sum with a loop
# Stores 10,20,30,40,50 at addresses 0..16, then adds them up.
# Expected: r6 = 150, r4 = 20
eketsa ho r3, r0, 10
boloka r3, 0(r0)
eketsa ho r3, r0, 20
boloka r3, 4(r0)
eketsa ho r3, r0, 30
boloka r3, 8(r0)
eketsa ho r3, r0, 40
boloka r3, 12(r0)
eketsa ho r3, r0, 50
boloka r3, 16(r0)
eketsa ho r4, r0, 0      # r4 = byte offset of the current element
eketsa ho r5, r0, 20     # r5 = end offset (5 words)
eketsa ho r6, r0, 0      # r6 = sum
loop: jara r7, 0(r4)     # r7 = array[i]
eketsa r6, r6, r7        # sum = sum + r7  (load-use stall)
eketsa ho r4, r4, 4      # next element
phapano r4, r5, loop     # repeat until r4 == 20
fin: tekano r0, r0, fin  # halt
