# LIMO example 3 - hazards and control
# RAW with forwarding, a load-use stall, and a taken branch that flushes 2.
# Expected: r4=30 r5=40 r6=40 r7=50 r8=0 r9=0 r10=9
eketsa ho r3, r0, 10
eketsa ho r4, r3, 20     # RAW on r3 (forwarded)
eketsa r5, r4, r3        # RAW on r4 and r3 (forwarded)
boloka r5, 0(r0)         # mem[0] = 40
jara r6, 0(r0)           # r6 = 40
eketsa r7, r6, r3        # uses r6 right after the load: 1 stall
tekano r3, r3, over      # always taken
eketsa ho r8, r0, 1      # flushed
eketsa ho r9, r0, 2      # flushed
over: eketsa ho r10, r0, 9
fin: tekano r0, r0, fin  # halt
